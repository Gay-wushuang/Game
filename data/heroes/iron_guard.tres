attack_artwork = ExtResource("3_attack")
skill_artwork = ExtResource("4_skill")
hit_artwork = ExtResource("5_hit")
defeated_artwork = ExtResource("6_defeated")
character_number = 1
hero_type = 0
initial_star = 0
max_hp = 150
attack = 10
innate_ability = &"segmented_guard"
