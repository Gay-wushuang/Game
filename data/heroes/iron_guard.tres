[resource]
script = ExtResource("1")
id = &"hero_role_1"
display_name = "荆铁"
description = "以分段减伤坚守前线，并用嘲讽替全体友方承受伤害的先锋。"
tags = PackedStringArray("先锋", "坦克", "嘲讽")
